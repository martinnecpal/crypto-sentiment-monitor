# .env.example - пример конфигурации (можно публиковать в GitHub)
# Скопируйте этот файл в .env и заполните реальными значениями

# Telegram настройки (обязательно)
TELEGRAM_WORKER_URL=https://your-worker.workers.dev
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API (опционально)
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# Настройки приложения
NEWS_SOURCES=cointelegraph,coindesk,bitcoinmagazine,cryptoslate
UPDATE_INTERVAL_HOURS=6